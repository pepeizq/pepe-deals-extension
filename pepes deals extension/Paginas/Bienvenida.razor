@page "/welcome.html"
@inherits BasePage

@using WebExtensions.Net

@inject IWebExtensionsApi Extensiones
@inject IJSRuntime JavaScript

<style>
    :root {
        --fondoSubsubcabecera: #293751;
        --fondoSubcabecera: #222b44;
        --fondoBoton: #146a9c;
        --fondoBotonPequeño: #0d1621;
        --fondoBotonPequeñoHover: #060a0f;
        --fondoMinimo: #002c47;
        --colorTexto: #f5f5f5;
        --colorTextoHover: #b9e2fa;
        --colorEnlace: #95c0fe;
        --colorEnlaceHover: #3486fd;
        --descuento: #006400;
    }

    body {
        margin: 0;
        font-family: 'Inter', Sans-serif;
        background: linear-gradient(180deg, var(--fondoSubsubcabecera) 0%, var(--fondoSubcabecera) 211.07%);
        min-height: 100vh;
        color: var(--colorTexto);
    }

    .pepeizq-bienvenida-contenedor {
        padding: 25px 30px;
        background: color-mix(in srgb, var(--fondoSubsubcabecera) 65%, var(--fondoBotonPequeño));
        box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28), 0px 0px 2px 0px rgba(0, 0, 0, 0.24);
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .pepeizq-bienvenida-boton {
        flex: 1;
        text-align: center;
        cursor: pointer;
        background-color: var(--fondoBotonPequeño);
        border: 2px solid var(--fondoBotonPequeño);
        padding: 10px 15px;
        color: var(--colorTexto);
        transition: transform .2s, background-color .2s, border-color .2s;
        border-radius: 5px;
        font-size: 16px;
    }

        .pepeizq-bienvenida-boton:hover {
            transform: scale(1.02);
            background-color: var(--fondoBotonPequeñoHover);
        }
</style>

<div style="display: flex; flex-direction: column; gap: 30px; margin: 40px auto; max-width: 700px;">
    <div class="pepeizq-bienvenida-contenedor" style="background: transparent; box-shadow: none; text-align: center; font-size: 18px; padding: 0px;">
        @WebExtensions.I18n.GetMessage("String31")
    </div>

    <div class="pepeizq-bienvenida-contenedor">
        <div style="display: flex; align-items: center; gap: 20px;">
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirOpciones">
                <div style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                    <div style="width: 22px; height: 22px;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                            <path fill="var(--colorTexto)" d="M259.1 73.5C262.1 58.7 275.2 48 290.4 48L350.2 48C365.4 48 378.5 58.7 381.5 73.5L396 143.5C410.1 149.5 423.3 157.2 435.3 166.3L503.1 143.8C517.5 139 533.3 145 540.9 158.2L570.8 210C578.4 223.2 575.7 239.8 564.3 249.9L511 297.3C511.9 304.7 512.3 312.3 512.3 320C512.3 327.7 511.8 335.3 511 342.7L564.4 390.2C575.8 400.3 578.4 417 570.9 430.1L541 481.9C533.4 495 517.6 501.1 503.2 496.3L435.4 473.8C423.3 482.9 410.1 490.5 396.1 496.6L381.7 566.5C378.6 581.4 365.5 592 350.4 592L290.6 592C275.4 592 262.3 581.3 259.3 566.5L244.9 496.6C230.8 490.6 217.7 482.9 205.6 473.8L137.5 496.3C123.1 501.1 107.3 495.1 99.7 481.9L69.8 430.1C62.2 416.9 64.9 400.3 76.3 390.2L129.7 342.7C128.8 335.3 128.4 327.7 128.4 320C128.4 312.3 128.9 304.7 129.7 297.3L76.3 249.8C64.9 239.7 62.3 223 69.8 209.9L99.7 158.1C107.3 144.9 123.1 138.9 137.5 143.7L205.3 166.2C217.4 157.1 230.6 149.5 244.6 143.4L259.1 73.5zM320.3 400C364.5 399.8 400.2 363.9 400 319.7C399.8 275.5 363.9 239.8 319.7 240C275.5 240.2 239.8 276.1 240 320.3C240.2 364.5 276.1 400.2 320.3 400z" />
                        </svg>
                    </div>

                    <div>
                        @WebExtensions.I18n.GetMessage("String32")
                    </div>
                </div>    
            </button>
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirWeb">
                <div style="margin-top: 1px;">
                    @WebExtensions.I18n.GetMessage("String33")
                </div>
            </button>
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirCodigoFuente">
                <div style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                    <div style="width: 22px; height: 22px;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                            <path fill="var(--colorTexto)" d="M280.5 426.5C214.5 418.5 168 371 168 309.5C168 284.5 177 257.5 192 239.5C185.5 223 186.5 188 194 173.5C214 171 241 181.5 257 196C276 190 296 187 320.5 187C345 187 365 190 383 195.5C398.5 181.5 426 171 446 173.5C453 187 454 222 447.5 239C463.5 258 472 283.5 472 309.5C472 371 425.5 417.5 358.5 426C375.5 437 387 461 387 488.5L387 540.5C387 555.5 399.5 564 414.5 558C505 523.5 576 433 576 321C576 179.5 461 64 319.5 64C178 64 64 179.5 64 321C64 432 134.5 524 229.5 558.5C243 563.5 256 554.5 256 541L256 501C249 504 240 506 232 506C199 506 179.5 488 165.5 454.5C160 441 154 433 142.5 431.5C136.5 431 134.5 428.5 134.5 425.5C134.5 419.5 144.5 415 154.5 415C169 415 181.5 424 194.5 442.5C204.5 457 215 463.5 227.5 463.5C240 463.5 248 459 259.5 447.5C268 439 274.5 431.5 280.5 426.5z" />
                        </svg>
                    </div>

                    <div>
                        @WebExtensions.I18n.GetMessage("String34")
                    </div>
                </div>
            </button>
        </div>
    </div>

    <div class="pepeizq-bienvenida-contenedor" style="margin-top: 40px; background: transparent; box-shadow: none; text-align: center; font-size: 15px; padding: 0px; line-height: 24px;">
        @WebExtensions.I18n.GetMessage("String35")
    </div>

    <div class="pepeizq-bienvenida-contenedor">
        <div style="display: flex; align-items: center; gap: 20px;">
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirSteam">
                Steam    
            </button>
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirGog">
                GOG
            </button>
            <button class="pepeizq-bienvenida-boton" @onclick="AbrirEpic">
                Epic Games Store
            </button>
        </div>
    </div>
</div>

@code {
    private async Task AbrirOpciones() => await Extensiones.Runtime.OpenOptionsPage();
    private async Task AbrirWeb() => await JavaScript.InvokeVoidAsync("open", "https://pepe.deals", "_blank");
    private async Task AbrirCodigoFuente() => await JavaScript.InvokeVoidAsync("open", "https://github.com/pepe-deals", "_blank");

    private async Task AbrirSteam() => await JavaScript.InvokeVoidAsync("open", "https://store.steampowered.com/app/606150/Moonlighter/", "_blank");
    private async Task AbrirGog() => await JavaScript.InvokeVoidAsync("open", "https://www.gog.com/game/moonlighter", "_blank");
    private async Task AbrirEpic() => await JavaScript.InvokeVoidAsync("open", "https://store.epicgames.com/p/moonlighter", "_blank");
}